import turtle
import math as mt
import scipy as sp

def move(x, y):
	
	turtle.up()
	turtle.forward(x)
	turtle.left(90)
	turtle.forward(y)
	turtle.right(90)
	turtle.down()

def polar_move(r, theta):
	""" move to a position in polar coordinates """

	turtle.up()
	turtle.left(theta)
	turtle.forward(r)
	turtle.right(theta)
	turtle.down()

def square(size, angle):
	""" draw a square of size lenght rotated by an angle"""

	turtle.left(angle)
	turtle.forward(size)
	turtle.left(90)
	turtle.forward(size)
	turtle.left(90)
	turtle.forward(size)
	turtle.left(90)
	turtle.forward(size)
	turtle.left(90 - angle)

def center_square(size, angle, center):
	""" draw a square of size lenght rotated by an angle and centered at position"""
	
	start_pos = turtle.position()

	move(center[0] - start_pos[0] - (size/mt.sqrt(2))*mt.cos(sp.pi/4 + mt.radians(angle)) , center[1] - start_pos[1] - (size/mt.sqrt(2))*mt.sin(sp.pi/4 + mt.radians(angle)))

	square(size, angle)

def nested_squares(size, angle, center, n: int = 2):
	"""   """
	for i in range(n):
		current_size = size/(mt.sqrt(2)**i)
		current_angle = angle + 45*i
	
		center_square(current_size, current_angle, center)





